{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free-Model-Router",
  "version": "0.8.2",
  "identifier": "com.konor123.free-model-router",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Free-Model-Router",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../dist/windows/Free-Model-Router.exe": "Free-Model-Router.exe",
      "../../dist/windows/Free-Model-Router.exe.metadata.json": "Free-Model-Router.exe.metadata.json",
      "../../dist/windows/fmr.exe": "fmr.exe"
    }
  }
}
